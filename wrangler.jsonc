{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tint-website",
  "compatibility_date": "2026-05-04",
  "main": "./worker/index.ts",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // The CI gate runs as a wrangler pre-deploy step, so it covers
  // every command that builds the Worker — `wrangler deploy` and
  // `wrangler versions upload`, whether triggered by Cloudflare
  // Workers Builds or by an operator from a local checkout. A
  // failure aborts the wrangler invocation that triggered it.
  // Rollback paths (`wrangler rollback`, dashboard rollback /
  // promote-version) reuse already-built bytes, so they don't
  // rebuild and don't run this gate — that is the deliberate
  // incident-response escape hatch. CI also runs these same
  // checks independently in .github/workflows/ci.yml for fast PR
  // feedback.
  "build": {
    "command": "npm run typecheck && npm run lint && npm run build && npm run smoke"
  }
}
