---
interface Props {
  code: string;
}

const { code } = Astro.props;
---

<button class="copy" type="button" data-code={code} aria-label="Copy command">
  <svg class="icon-copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
    <path d="M5 15c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h9c1.1 0 2 .9 2 2" />
  </svg>
  <svg class="icon-check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="20 6 9 17 4 12" />
  </svg>
</button>

<script>
  // data-code carries the source string verbatim — querying the rendered <code>
  // would pick up Shiki's HTML-escaped version (& → &amp; etc.).
  document.querySelectorAll<HTMLButtonElement>('button.copy[data-code]').forEach((btn) => {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(btn.dataset.code ?? '').then(() => {
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1200);
      });
    });
  });
</script>
