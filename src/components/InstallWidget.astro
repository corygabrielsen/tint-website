---
// Install command widget: a tabbed code block where each tab body is a
// shiki-tokenised <pre> that doubles as a click-to-copy button.
//
// - Tabs are driven by hidden radio inputs + a `:has(input:nth-of-type(N):checked)`
//   selector chain, so active-state switching is pure CSS with no JS.
// - The whole pre+icon row is a single <button data-copy>; clicking anywhere
//   in the row copies the command's textContent to the clipboard and flips
//   the copy icon to a check for 1.5s.
// - Long commands wrap terminal-style (any character is a valid break point)
//   instead of producing a horizontal scrollbar inside the click row, so
//   users can read the entire command before pasting it into a shell.
import { Code } from 'astro:components';

interface Command {
  label: string;
  code: string;
}

interface Props {
  commands: readonly Command[];
  id?: string;
}

const { commands, id = 'install-widget' } = Astro.props;
---

<fieldset class="install-widget" id={id}>
  <legend class="sr-only">Install method</legend>
  {/* Three separate maps so the radios, labels, and panels stay in stable
      source order: the :nth-of-type / :nth-child selectors below match by
      position, not id, so a single combined loop would shuffle the order
      and break the active-tab mapping. */}
  {commands.map((cmd, i) => (
    <input
      class="sr-only"
      type="radio"
      name={`${id}-radios`}
      id={`${id}-${cmd.label}`}
      checked={i === 0}
    />
  ))}
  <div class="tabs">
    {commands.map((cmd) => (
      <label for={`${id}-${cmd.label}`}>{cmd.label}</label>
    ))}
  </div>
  <div class="panels">
    {commands.map((cmd) => (
      <div class="panel"><button data-copy type="button" class="command" aria-label={`Copy ${cmd.label} command`}><span class="command-script"><Code code={cmd.code} lang="sh" theme="css-variables" /></span><span class="copy-status"><svg class="icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true"><path d="M8.75 8.75V2.75H21.25V15.25H15.25M15.25 8.75H2.75V21.25H15.25V8.75Z" /></svg><svg class="icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M2.75 15.0938L9 20.25L21.25 3.75" /></svg></span></button></div>
    ))}
  </div>
</fieldset>

<style>
  .install-widget {
    border: 1px solid var(--border);
    background: var(--code-bg);
    /* fieldset and flex-item defaults treat min-inline-size as min-content,
       which lets long install commands stretch the widget past the
       viewport. Resetting both lets the inner pre handle layout instead. */
    min-width: 0;
    min-inline-size: 0;
  }

  .install-widget .panels,
  .install-widget .panel {
    min-width: 0;
  }

  .install-widget .tabs {
    display: flex;
    border-bottom: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 0.875rem;
  }

  .install-widget .tabs label {
    padding: 0.5rem 1rem;
    cursor: pointer;
    color: var(--muted);
    border-right: 1px solid var(--border);
    user-select: none;
  }

  .install-widget .tabs label:hover {
    color: var(--fg);
  }

  /* Active tab "pops out" of the panel by switching to the page bg. Extend
     with another :nth pair to add a third tab. */
  .install-widget:has(input:nth-of-type(1):checked) .tabs label:nth-child(1),
  .install-widget:has(input:nth-of-type(2):checked) .tabs label:nth-child(2) {
    color: var(--fg);
    background: var(--bg);
  }

  .install-widget:has(input:nth-of-type(1):focus-visible) .tabs label:nth-child(1),
  .install-widget:has(input:nth-of-type(2):focus-visible) .tabs label:nth-child(2) {
    outline: 2px solid var(--fg);
    outline-offset: -2px;
  }

  /* :has()-capable browsers hide all panels and reveal the active one;
     browsers without :has() show all panels (degraded but functional
     instead of a blank widget). */
  @supports selector(:has(*)) {
    .install-widget .panels .panel {
      display: none;
    }

    .install-widget:has(input:nth-of-type(1):checked) .panels .panel:nth-child(1),
    .install-widget:has(input:nth-of-type(2):checked) .panels .panel:nth-child(2) {
      display: block;
    }
  }

  /* The clickable command row spans the full panel and lays the body next
     to the icon column. `all: unset` strips browser button styles; we then
     pin box-sizing back to border-box (the global * reset is undone by the
     `all: unset` cascade) and re-impose the panel typography on the inner
     pre below. */
  .install-widget .command {
    all: unset;
    box-sizing: border-box;
    display: flex;
    width: 100%;
    max-width: 100%;
    cursor: pointer;
    /* Anchor the icon to the top of the row so it sits beside the first
       line of long wrapped commands instead of drifting to the visual
       middle of a multi-line block. */
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    color: var(--fg);
    font-family: var(--mono);
  }

  .install-widget .command:hover {
    background: color-mix(in srgb, var(--code-bg) 90%, var(--fg) 10%);
  }

  /* `flex: 1 1 0; min-width: 0` lets the script slot shrink below its
     intrinsic content width so the inner pre's wrap rules can break long
     URLs at the row's right edge instead of pushing the icon off-screen. */
  .install-widget .command-script {
    flex: 1 1 0;
    min-width: 0;
  }

  /* Strip shiki's <pre> chrome and wrap terminal-style: any character is a
     valid break point so long URLs and paths split cleanly at the panel's
     right edge instead of producing a horizontal scrollbar inside the
     click row. Honesty over compactness — users have to trust what they're
     piping into a shell, and `…`-style truncation obscures that. */
  .install-widget .command-script pre {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: inherit;
    font-size: 0.875rem;
    white-space: pre-wrap;
    word-break: break-all;
    overflow: visible;
  }

  .install-widget .command-script code {
    font-family: inherit;
  }

  .install-widget .copy-status {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* Icon swap is driven by the [data-copied] attribute the script toggles
     on the parent <button data-copy>. */
  .install-widget .icon-copy {
    display: block;
    width: 16px;
    height: 16px;
    color: color-mix(in srgb, var(--muted) 55%, var(--bg) 45%);
  }

  .install-widget [data-copied] .icon-copy {
    display: none;
  }

  .install-widget .icon-check {
    display: none;
    width: 16px;
    height: 16px;
  }

  .install-widget [data-copied] .icon-check {
    display: block;
  }
</style>

<script>
  // Astro compiles this <script> as TypeScript and ships compiled JS, so the
  // generic type parameters below are erased at build time.
  const RESET_MS = 1500;
  // Per-button timer so a fast second click doesn't let an earlier reset
  // wipe the later flash mid-flight.
  const timers = new WeakMap<HTMLButtonElement, number>();

  // Read clipboard payload from textContent (same trick as opencode.ai's
  // install widget) and collapse any incidental whitespace from
  // server-rendered HTML so commands round-trip cleanly without us having
  // to micro-format the JSX whitespace.
  document
    .querySelectorAll<HTMLButtonElement>('.install-widget [data-copy]')
    .forEach((btn) => {
      btn.addEventListener('click', async (event) => {
        const raw = (event.currentTarget as HTMLButtonElement).textContent ?? '';
        const text = raw.replace(/\s+/g, ' ').trim();
        try {
          await navigator.clipboard.writeText(text);
          btn.setAttribute('data-copied', '');
          const prev = timers.get(btn);
          if (prev !== undefined) window.clearTimeout(prev);
          timers.set(
            btn,
            window.setTimeout(() => btn.removeAttribute('data-copied'), RESET_MS),
          );
        } catch (err) {
          console.error('Clipboard write failed:', err);
        }
      });
    });
</script>
