---
import '~/styles/global.css';

interface Props {
  title: string;
  description?: string;
  favicon?: string;
}

const {
  title,
  description = 'Terminal theme switcher.',
  favicon = '/favicon.svg',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
