---
import '~/styles/global.css';

interface Props {
  title: string;
  // Required, no default. The previous `'Terminal theme switcher.'` default
  // was the homepage tagline and silently shipped into the 404 page's
  // <meta name="description">, which leaks into search results and social
  // previews. Forcing each page to provide its own description prevents
  // that drift.
  description: string;
  favicon?: string;
}

const { title, description, favicon = '/favicon.svg' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>{title}</title>
    {/* Plausible Analytics: privacy-friendly RUM. The script bundle URL
        is keyed to the tint.sh site (not a user secret); domain
        identification is baked into pa-2GDvlSNQ-zZ5v8bZRNwrQ.js. is:inline
        keeps Astro from bundling/transforming the snippet so it lands in
        <head> verbatim, matching what plausible.io provides. The Worker
        also fires server-side `tint_download` events on /tint hits — see
        worker/index.ts. */}
    <script is:inline async src="https://plausible.io/js/pa-2GDvlSNQ-zZ5v8bZRNwrQ.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
