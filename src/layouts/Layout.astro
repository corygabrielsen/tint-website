---
import '~/styles/global.css';

interface Props {
  title: string;
  // Required, no default. The previous `'Terminal theme switcher.'` default
  // was the homepage tagline and silently shipped into the 404 page's
  // <meta name="description">, which leaks into search results and social
  // previews. Forcing each page to provide its own description prevents
  // that drift.
  description: string;
  favicon?: string;
}

const { title, description, favicon = '/favicon.svg' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>{title}</title>
    {/* Plausible Analytics: privacy-friendly RUM. The bundle URL is
        keyed to the tint.sh site (not a user secret); domain
        identification is baked into pa-2GDvlSNQ-zZ5v8bZRNwrQ.js.

        Hostname gate: the Plausible bundle auto-fires a pageview when
        it loads, so suppressing analytics on non-canonical hosts means
        not loading the bundle at all (gating only `plausible.init()`
        wouldn't help — the pageview happens at script load). On
        *.workers.dev verification hits, on any future preview/staging
        hostname, and during local `astro dev`, the snippet short-
        circuits and Plausible never sees the request. The symmetric
        server-side gate lives in worker/index.ts; together they keep
        the dashboard a faithful record of real production traffic.

        is:inline keeps Astro from bundling/transforming the snippet
        so it lands in <head> verbatim. */}
    <script is:inline>
      if (location.hostname === 'tint.sh') {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://plausible.io/js/pa-2GDvlSNQ-zZ5v8bZRNwrQ.js';
        document.head.appendChild(s);
        window.plausible = window.plausible || function () { (plausible.q = plausible.q || []).push(arguments); };
        window.plausible.init = window.plausible.init || function (i) { plausible.o = i || {}; };
        window.plausible.init();
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
