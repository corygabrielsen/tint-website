---
import '~/styles/global.css';

interface Props {
  title: string;
  // Required, no default. The previous `'Terminal theme switcher.'` default
  // was the homepage tagline and silently shipped into the 404 page's
  // <meta name="description">, which leaks into search results and social
  // previews. Forcing each page to provide its own description prevents
  // that drift.
  description: string;
  favicon?: string;
}

const { title, description, favicon = '/favicon.svg' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
