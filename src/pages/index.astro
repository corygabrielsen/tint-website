---
import Layout from '~/layouts/Layout.astro';
import { Code } from 'astro:components';

const themes = { light: 'github-light', dark: 'github-dark' } as const;
const brew = 'brew install corygabrielsen/tint/tint';
const curl =
  'curl -fsSL https://github.com/corygabrielsen/tint/releases/latest/download/tint -o ~/.local/bin/tint && chmod +x ~/.local/bin/tint';
---

<Layout title="tint">
  <main>
    <h1>tint</h1>
    <p class="tagline">Terminal theme switcher.</p>

    <div class="install-tabs">
      <input type="radio" name="install" id="install-brew" checked />
      <input type="radio" name="install" id="install-curl" />
      <div class="tabs" role="tablist">
        <label for="install-brew">brew</label>
        <label for="install-curl">curl</label>
      </div>
      <div class="blocks">
        <div class="block">
          <button class="copy" type="button" aria-label="Copy command">
            <svg class="icon-copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h9c1.1 0 2 .9 2 2" />
            </svg>
            <svg class="icon-check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </button>
          <Code code={brew} lang="sh" themes={themes} />
        </div>
        <div class="block">
          <button class="copy" type="button" aria-label="Copy command">
            <svg class="icon-copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h9c1.1 0 2 .9 2 2" />
            </svg>
            <svg class="icon-check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </button>
          <Code code={curl} lang="sh" themes={themes} />
        </div>
      </div>
    </div>

    <div class="demo-placeholder">Demo coming soon</div>

    <p class="github-link">
      <a href="https://github.com/corygabrielsen/tint" aria-label="GitHub repository">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
      </a>
    </p>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.install-tabs .copy').forEach((btn) => {
    btn.addEventListener('click', () => {
      const code = btn.parentElement?.querySelector('code')?.textContent ?? '';
      navigator.clipboard.writeText(code).then(() => {
        btn.classList.add('copied');
        setTimeout(() => {
          btn.classList.remove('copied');
        }, 1200);
      });
    });
  });
</script>
