---
import Layout from '~/layouts/Layout.astro';
import GitHubMark from '~/components/GitHubMark.astro';
import CommandTabs from '~/components/CommandTabs.astro';
import CopyCommand from '~/components/CopyCommand.astro';

const repoUrl = 'https://github.com/corygabrielsen/tint';

// Install lines stay tight on purpose: mkdir/PATH guidance live in the tint
// README, not here. `brew install user/repo/formula` auto-taps the third-party
// tap on first install, so no `brew tap` step is needed.
//
// The curl one-liner uses `https://tint.sh/tint`, served by the Worker
// (worker/index.ts) as a 302 to the canonical GitHub release asset.
// curl follows the redirect to that asset, which increments GitHub's
// per-asset `download_count`; the Worker fires a Plausible
// `tint_download` event in parallel.
//
// `as const` narrows the tuple so labels stay accurate to source order.
// CommandTabs's :nth-of-type CSS supports up to 6 tabs per level — adding
// further install methods or sub-methods renders correctly without
// further changes.
//
// Sub-tab order matters: the first child gets the default-checked radio
// in CommandTabs, so the leftmost git sub-tab is what a viewer sees on
// first reveal. ssh is leftmost because git-clone-via-ssh is the most
// common developer workflow for this audience.
const installTabs = [
  { label: 'brew', code: 'brew install corygabrielsen/tint/tint' },
  {
    label: 'curl',
    code: 'curl -fsSL https://tint.sh/tint -o ~/.local/bin/tint && chmod +x ~/.local/bin/tint',
  },
  {
    label: 'git',
    tabs: [
      // Mirror GitHub's clone dropdown: https leftmost (newcomer-friendly,
      // works with no setup), ssh auto-selected (the typical reader has
      // a key on file and prefers it).
      { label: 'https', code: 'git clone https://github.com/corygabrielsen/tint.git' },
      { label: 'ssh',   code: 'git clone git@github.com:corygabrielsen/tint.git', default: true },
      { label: 'gh',    code: 'gh repo clone corygabrielsen/tint' },
      { label: 'gt',    code: 'gt clone corygabrielsen/tint' },
    ],
  },
] as const;

// Hue-sorted colors from public/favicon.svg.
const themeColors = [
  '#AC5353',
  '#AC7453',
  '#AC9653',
  '#A1AC53',
  '#80AC53',
  '#5EAC53',
  '#53AC69',
  '#53AC8B',
  '#53ACAC',
  '#538BAC',
  '#5369AC',
  '#5E53AC',
  '#8053AC',
  '#A153AC',
  '#AC5396',
  '#AC5374',
];

const cdHookBody = `mkdir -p /tmp/tinted && echo nord > /tmp/tinted/.tint
cd /tmp/tinted`;

const featureDemos = [
  {
    id: 'apply-by-name',
    title: 'Apply a theme by name',
    description: 'Use any theme directly from your shell. Instantly.',
    command: 'tint dracula',
    src: 'demo-cli.mp4',
    poster: 'demo-cli-poster.png',
    ariaLabel: 'Applying built-in tint themes by name',
  },
  {
    id: 'cd-hook',
    title: 'Automatically switch themes when changing directories',
    description: 'Install the shell hook once, then add `.tint` files to automatically switch themes when changing directories. Supports Bash and Zsh.',
    // bash and zsh emit different hook scripts, so the eval target differs
    // between tabs while the rest of the snippet is identical.
    commands: [
      { label: 'bash', code: `eval "$(tint hook bash)"\n${cdHookBody}` },
      { label: 'zsh',  code: `eval "$(tint hook zsh)"\n${cdHookBody}` },
    ] as const,
    src: 'demo-cd-hook.mp4',
    poster: 'demo-cd-hook-poster.png',
    ariaLabel: 'Automatically applying tint themes when changing directories',
  },
  {
    id: 'picker',
    title: 'Browse and select themes interactively',
    description: 'Run `tint` with no arguments to scroll and select themes interactively in your terminal.',
    command: 'tint',
    src: 'demo-picker.mp4',
    poster: 'demo-picker-poster.png',
    ariaLabel: 'Selecting a tint theme in the interactive picker',
  },
  {
    id: 'custom-theme',
    title: 'Use custom themes',
    description: 'Add custom themes to tint’s XDG themes directory, then use them like built-in themes. Each `.theme` file defines one or more themes.',
    command: `mkdir -p ~/.config/tint/themes
cat > ~/.config/tint/themes/matrix.theme <<'EOF'
matrix:#000000:#00ff00:#000000:#008800:#00ff00:#aaff00:#005533:#00aa55:#00ff66:#88ff99:#003311:#00bb22:#33ff44:#bbff44:#006644:#00cc66:#44ff77:#ddffdd
EOF
tint matrix`,
    src: 'demo-custom-theme.mp4',
    poster: 'demo-custom-theme-poster.png',
    ariaLabel: 'Adding and applying a custom tint theme',
  },
];

type InlineDescriptionPart = {
  code: boolean;
  text: string;
};

function inlineDescriptionParts(text: string): InlineDescriptionPart[] {
  const parts: InlineDescriptionPart[] = [];
  let cursor = 0;

  for (const match of text.matchAll(/`([^`]+)`/g)) {
    const start = match.index ?? 0;
    if (start > cursor) {
      parts.push({ code: false, text: text.slice(cursor, start) });
    }
    parts.push({ code: true, text: match[1] ?? '' });
    cursor = start + match[0].length;
  }

  if (cursor < text.length) {
    parts.push({ code: false, text: text.slice(cursor) });
  }

  return parts;
}
---

<Layout
  title="tint - Terminal Theme Switcher"
  description="Terminal theme switcher with live preview, directory-based switching, and custom theme support."
>
  <main>
    <header>
      <h1>tint</h1>
      <div class="theme-strip" aria-hidden="true">
        {themeColors.map((color) => (
          <span style={`background-color: ${color}`}></span>
        ))}
      </div>
      <p class="tagline">Terminal theme switcher.</p>
    </header>

    <CommandTabs tabs={installTabs} />

    <div class="demo-frame" data-demo-frame>
      <video
        class="demo"
        data-demo-video
        src="demo.mp4"
        poster="demo-poster.png"
        loop
        muted
        playsinline
        preload="metadata"
        width="1704"
        height="864"
        aria-label="tint demo: CLI, cd-hook auto-tinting, picker, custom theme"
      ></video>
      <img
        class="demo-poster"
        data-demo-poster
        src="demo-poster.png"
        width="1704"
        height="864"
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="sync"
      />
      <span class="demo-play-overlay" aria-hidden="true"></span>
      <noscript>
        <a class="demo-fallback-link" href="demo.mp4">Open demo video</a>
      </noscript>
    </div>

    <div class="feature-demos">
      {featureDemos.map((demo) => (
        <section class="feature-demo" data-feature-demo aria-labelledby={`feature-${demo.id}`}>
          <div class="feature-copy">
            <h2 id={`feature-${demo.id}`}>{demo.title}</h2>
            <p>
              {inlineDescriptionParts(demo.description).map((part) =>
                part.code ? <code>{part.text}</code> : part.text,
              )}
            </p>
            {demo.commands ? (
              <CommandTabs tabs={demo.commands} id={`cmd-${demo.id}`} />
            ) : (
              <CopyCommand code={demo.command} variant="card" />
            )}
          </div>
          <div class="demo-frame" data-demo-frame>
            <video
              class="demo"
              data-demo-video
              src={demo.src}
              poster={demo.poster}
              loop
              muted
              playsinline
              preload="metadata"
              width="1704"
              height="864"
              aria-label={demo.ariaLabel}
            ></video>
            <img
              class="demo-poster"
              data-demo-poster
              src={demo.poster}
              width="1704"
              height="864"
              alt=""
              aria-hidden="true"
              loading="eager"
              decoding="sync"
            />
            <span class="demo-play-overlay" aria-hidden="true"></span>
            <noscript>
              <a class="demo-fallback-link" href={demo.src}>Open demo video</a>
            </noscript>
          </div>
        </section>
      ))}
    </div>

    <p class="github-link">
      <a href={repoUrl} aria-label="GitHub repository">
        <GitHubMark />
      </a>
    </p>

    <p class="copyright">© 2026 Cory Gabrielsen</p>
  </main>

<script>
  import { wireDemoVideos } from '~/scripts/demo-videos';

  wireDemoVideos();
</script>
</Layout>
