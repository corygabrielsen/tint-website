---
import Layout from '~/layouts/Layout.astro';
---

<Layout title="tint">
  <main>
    <h1>tint</h1>
    <p class="tagline">Terminal theme switcher.</p>

    <pre><code>brew install corygabrielsen/tint/tint</code></pre>
    <pre><code>curl -fsSL https://github.com/corygabrielsen/tint/releases/latest/download/tint -o ~/.local/bin/tint && chmod +x ~/.local/bin/tint</code></pre>

    <div class="demo-placeholder">Demo coming soon</div>

    <p><a href="https://github.com/corygabrielsen/tint">github.com/corygabrielsen/tint</a></p>
  </main>
</Layout>
