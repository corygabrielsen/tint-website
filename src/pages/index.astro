---
import { Code } from 'astro:components';
import Layout from '~/layouts/Layout.astro';
import CopyButton from '~/components/CopyButton.astro';
import GitHubMark from '~/components/GitHubMark.astro';

const repoUrl = 'https://github.com/corygabrielsen/tint';
const themes = { light: 'github-light', dark: 'github-dark' } as const;

const installCommands = [
  { id: 'install-brew', label: 'brew', code: 'brew install corygabrielsen/tint/tint' },
  {
    id: 'install-curl',
    label: 'curl',
    code: `curl -fsSL ${repoUrl}/releases/latest/download/tint -o ~/.local/bin/tint && chmod +x ~/.local/bin/tint`,
  },
];
---

<Layout title="tint">
  <main>
    <h1>tint</h1>
    <p class="tagline">Terminal theme switcher.</p>

    <div class="install-tabs">
      {installCommands.map((cmd, i) => (
        <input type="radio" name="install" id={cmd.id} checked={i === 0} />
      ))}
      <div class="tabs">
        {installCommands.map((cmd) => (
          <label for={cmd.id}>{cmd.label}</label>
        ))}
      </div>
      <div class="panels">
        {installCommands.map((cmd) => (
          <div class="panel">
            <CopyButton code={cmd.code} />
            <Code code={cmd.code} lang="sh" themes={themes} />
          </div>
        ))}
      </div>
    </div>

    <div class="demo-placeholder">Demo coming soon</div>

    <p class="github-link">
      <a href={repoUrl} aria-label="GitHub repository">
        <GitHubMark />
      </a>
    </p>

    <p class="copyright">© {new Date().getFullYear()} Cory Gabrielsen</p>
  </main>
</Layout>
