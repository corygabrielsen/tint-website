---
import Layout from '~/layouts/Layout.astro';
import GitHubMark from '~/components/GitHubMark.astro';
import InstallWidget from '~/components/InstallWidget.astro';

const repoUrl = 'https://github.com/corygabrielsen/tint';

// Install lines stay tight on purpose: mkdir/PATH guidance live in the tint
// README, not here. `brew install user/repo/formula` auto-taps the third-party
// tap on first install, so no `brew tap` step is needed.
//
// The curl one-liner uses `https://tint.sh/tint`, served by the Worker
// (worker/index.ts) as a 302 to the canonical GitHub release asset.
// curl follows the redirect to that asset, which increments GitHub's
// per-asset `download_count`; the Worker fires a Plausible
// `tint_download` event in parallel.
//
// `as const` narrows this to a 2-tuple so it satisfies InstallWidget's
// `readonly [Command, Command]` prop. Adding a third install method here
// without first extending the widget's :nth-of-type CSS would now be a
// compile error rather than a silently broken tab.
const installCommands = [
  { label: 'brew', code: 'brew install corygabrielsen/tint/tint' },
  {
    label: 'curl',
    code: 'curl -fsSL https://tint.sh/tint -o ~/.local/bin/tint && chmod +x ~/.local/bin/tint',
  },
] as const;

// Hue-sorted colors from public/favicon.svg.
const themeColors = [
  '#AC5353',
  '#AC7453',
  '#AC9653',
  '#A1AC53',
  '#80AC53',
  '#5EAC53',
  '#53AC69',
  '#53AC8B',
  '#53ACAC',
  '#538BAC',
  '#5369AC',
  '#5E53AC',
  '#8053AC',
  '#A153AC',
  '#AC5396',
  '#AC5374',
];

const featureDemos = [
  {
    id: 'apply-by-name',
    title: 'Set a theme by name',
    description: 'Use any theme directly from your shell. Instantly.',
    command: 'tint dracula',
    src: 'demo-cli.mp4',
    alt: 'Applying built-in tint themes by name',
  },
  {
    id: 'picker',
    title: 'Browse and select themes interactively',
    description: 'Run `tint` with no arguments to scroll and select themes interactively in your terminal.',
    command: 'tint',
    src: 'demo-picker.mp4',
    alt: 'Selecting a tint theme in the interactive picker',
  },
  {
    id: 'cd-hook',
    title: 'Switch themes when changing directories',
    description: 'Install the shell hook once, then add `.tint` files to automatically switch themes when changing directories. Supports Bash and Zsh.',
    command: `eval "$(tint hook bash)"
echo dracula > .tint`,
    src: 'demo-cd-hook.mp4',
    alt: 'Automatically applying tint themes when changing directories',
  },
  {
    id: 'custom-theme',
    title: 'Use custom themes',
    description: 'Add custom themes to tint’s XDG themes directory, then use them like built-in themes. Each `.theme` file defines one or more themes.',
    command: `mkdir -p ~/.config/tint/themes
cat > ~/.config/tint/themes/matrix.theme <<'EOF'
matrix:#000000:#00ff00:#000000:#008800:#00ff00:#aaff00:#005533:#00aa55:#00ff66:#88ff99:#003311:#00bb22:#33ff44:#bbff44:#006644:#00cc66:#44ff77:#ddffdd
EOF
tint matrix`,
    src: 'demo-custom-theme.mp4',
    alt: 'Adding and applying a custom tint theme',
  },
];

type InlineDescriptionPart = {
  code: boolean;
  text: string;
};

function inlineDescriptionParts(text: string): InlineDescriptionPart[] {
  const parts: InlineDescriptionPart[] = [];
  let cursor = 0;

  for (const match of text.matchAll(/`([^`]+)`/g)) {
    const start = match.index ?? 0;
    if (start > cursor) {
      parts.push({ code: false, text: text.slice(cursor, start) });
    }
    parts.push({ code: true, text: match[1] ?? '' });
    cursor = start + match[0].length;
  }

  if (cursor < text.length) {
    parts.push({ code: false, text: text.slice(cursor) });
  }

  return parts;
}
---

<Layout
  title="tint - Terminal Theme Switcher"
  description="Terminal theme switcher with live preview, directory-based switching, and custom theme support."
>
  <main>
    <header>
      <h1>tint</h1>
      <div class="theme-strip" aria-hidden="true">
        {themeColors.map((color) => (
          <span style={`background-color: ${color}`}></span>
        ))}
      </div>
      <p class="tagline">Terminal theme switcher.</p>
    </header>

    <InstallWidget commands={installCommands} />

    {/* TODO: Add a small static poster image for MP4 load/decode failures. */}
    <div class="demo-frame" data-demo-frame role="button" tabindex="0" aria-label="Play demo video">
      <video
        class="demo"
        data-demo-video
        src="demo.mp4"
        loop
        muted
        playsinline
        preload="metadata"
        width="824"
        height="450"
        aria-label="tint demo: picker, CLI, cd-hook auto-tinting, custom theme"
      ></video>
      <span class="demo-play-overlay" aria-hidden="true"></span>
    </div>

    <div class="feature-demos">
      {featureDemos.map((demo) => (
        <section class="feature-demo" data-feature-demo aria-labelledby={`feature-${demo.id}`}>
          <div class="feature-copy">
            <h2 id={`feature-${demo.id}`}>{demo.title}</h2>
            <p>
              {inlineDescriptionParts(demo.description).map((part) =>
                part.code ? <code>{part.text}</code> : part.text,
              )}
            </p>
            <button
              type="button"
              class="feature-command"
              data-feature-command
              data-feature-copy
              data-code={demo.command}
              aria-label={`Copy ${demo.title} command`}
            >
              <code>{demo.command}</code>
              <span class="feature-copy-status">
                <svg
                  class="icon-copy"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="square"
                  aria-hidden="true"
                >
                  <path d="M8.75 8.75V2.75H21.25V15.25H15.25M15.25 8.75H2.75V21.25H15.25V8.75Z" />
                </svg>
                <svg
                  class="icon-check"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="square"
                  aria-hidden="true"
                >
                  <path d="M2.75 15.0938L9 20.25L21.25 3.75" />
                </svg>
                <span class="feature-copy-announce sr-only" aria-live="polite"></span>
              </span>
            </button>
          </div>
          <div class="demo-frame" data-demo-frame role="button" tabindex="0" aria-label="Play demo video">
            <video
              class="demo"
              data-demo-video
              src={demo.src}
              loop
              muted
              playsinline
              preload="metadata"
              width="824"
              height="450"
              aria-label={demo.alt}
            ></video>
            <span class="demo-play-overlay" aria-hidden="true"></span>
          </div>
        </section>
      ))}
    </div>

    <p class="github-link">
      <a href={repoUrl} aria-label="GitHub repository">
        <GitHubMark />
      </a>
    </p>

    <p class="copyright">© 2026 Cory Gabrielsen</p>
  </main>

<script>
  const FEATURE_COPY_RESET_MS = 1500;
  const featureCopyTimers = new WeakMap<HTMLButtonElement, number>();

  document.querySelectorAll<HTMLButtonElement>('[data-feature-copy]').forEach((btn) => {
    const announce = btn.querySelector<HTMLSpanElement>('.feature-copy-announce');

    btn.addEventListener('click', async () => {
      const text = btn.dataset.code ?? '';
      let success = false;
      try {
        await navigator.clipboard.writeText(text);
        success = true;
      } catch (err) {
        console.error('Feature command clipboard write failed:', err);
      }

      if (success) {
        btn.setAttribute('data-copied', '');
        if (announce) announce.textContent = 'Copied';
      } else if (announce) {
        announce.textContent = 'Copy failed';
      }

      const prev = featureCopyTimers.get(btn);
      if (prev !== undefined) window.clearTimeout(prev);
      featureCopyTimers.set(
        btn,
        window.setTimeout(() => {
          btn.removeAttribute('data-copied');
          if (announce) announce.textContent = '';
        }, FEATURE_COPY_RESET_MS),
      );
    });
  });
</script>

<script>
  const DEMO_VIDEO_MIN_VISIBLE_RATIO = 0.12;
  const demoFrames = [...document.querySelectorAll<HTMLElement>('[data-demo-frame]')];
  const demoVideos = demoFrames
    .map((frame) => frame.querySelector<HTMLVideoElement>('[data-demo-video]'))
    .filter((video): video is HTMLVideoElement => Boolean(video));
  const demoVideoFrames = new Map<HTMLVideoElement, HTMLElement>();
  let activeDemoVideo: HTMLVideoElement | null = null;
  let manualDemoVideo: HTMLVideoElement | null = null;
  let isDemoUserPaused = false;
  let demoPlaybackFrame = 0;

  for (const frame of demoFrames) {
    const video = frame.querySelector<HTMLVideoElement>('[data-demo-video]');
    if (video) demoVideoFrames.set(video, frame);
  }

  function resetDemoVideo(video: HTMLVideoElement): void {
    video.pause();
    if (video.currentTime > 0.05) {
      try {
        video.currentTime = 0;
      } catch {
        // Some browsers can reject seeks before metadata is ready.
      }
    }
  }

  function focusScore(video: HTMLVideoElement): number {
    const rect = video.getBoundingClientRect();
    const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
    const viewportWidth = window.innerWidth || document.documentElement.clientWidth;
    const visibleWidth = Math.max(0, Math.min(rect.right, viewportWidth) - Math.max(rect.left, 0));
    const visibleHeight = Math.max(0, Math.min(rect.bottom, viewportHeight) - Math.max(rect.top, 0));
    const area = Math.max(1, rect.width * rect.height);
    const visibleRatio = (visibleWidth * visibleHeight) / area;

    if (visibleRatio < DEMO_VIDEO_MIN_VISIBLE_RATIO) return Number.NEGATIVE_INFINITY;

    const videoCenter = rect.top + rect.height / 2;
    const viewportCenter = viewportHeight / 2;
    const centerDistance = Math.abs(videoCenter - viewportCenter) / Math.max(1, viewportHeight);

    return visibleRatio - centerDistance * 0.25;
  }

  function focusedDemoVideo(): HTMLVideoElement | null {
    let best: HTMLVideoElement | null = null;
    let bestScore = Number.NEGATIVE_INFINITY;

    for (const video of demoVideos) {
      const score = focusScore(video);
      if (score > bestScore) {
        best = video;
        bestScore = score;
      }
    }

    return best;
  }

  function updateDemoFrameStates(next: HTMLVideoElement | null): void {
    for (const video of demoVideos) {
      const frame = demoVideoFrames.get(video);
      if (!frame) continue;

      const isActive = video === next;
      frame.toggleAttribute('data-demo-active', isActive);
      frame.toggleAttribute('data-demo-paused', isActive && isDemoUserPaused);
      frame.setAttribute(
        'aria-label',
        isActive && !isDemoUserPaused ? 'Pause demo video' : 'Play demo video',
      );
    }
  }

  function updateDemoPlayback(): void {
    demoPlaybackFrame = 0;

    if (document.visibilityState === 'hidden') {
      for (const video of demoVideos) resetDemoVideo(video);
      activeDemoVideo = null;
      updateDemoFrameStates(null);
      return;
    }

    const next = manualDemoVideo ?? focusedDemoVideo();
    for (const video of demoVideos) {
      if (video !== next) {
        if (isDemoUserPaused) {
          video.pause();
        } else {
          resetDemoVideo(video);
        }
      }
    }

    if (!next) {
      activeDemoVideo = null;
      updateDemoFrameStates(null);
      return;
    }

    if (!isDemoUserPaused && activeDemoVideo !== next && next.currentTime > 0.05) {
      try {
        next.currentTime = 0;
      } catch {
        // Metadata may not be ready yet; play() will start from the beginning.
      }
    }

    activeDemoVideo = next;
    updateDemoFrameStates(next);

    if (isDemoUserPaused) {
      next.pause();
      return;
    }

    if (next.paused) {
      void next.play().catch(() => {
        // Autoplay can still be blocked in unusual browser settings; leave controls hidden.
      });
    }
  }

  function clearManualDemoVideo(): void {
    manualDemoVideo = null;
    scheduleDemoPlaybackUpdate();
  }

  function toggleDemoVideo(video: HTMLVideoElement): void {
    const clickedWasPlaying = video === activeDemoVideo && !isDemoUserPaused;
    manualDemoVideo = video;
    isDemoUserPaused = clickedWasPlaying;
    updateDemoPlayback();
  }

  function scheduleDemoPlaybackUpdate(): void {
    if (demoPlaybackFrame === 0) {
      demoPlaybackFrame = window.requestAnimationFrame(updateDemoPlayback);
    }
  }

  if (demoVideos.length > 0) {
    if ('IntersectionObserver' in window) {
      const thresholds = Array.from({ length: 11 }, (_, i) => i / 10);
      const observer = new IntersectionObserver(scheduleDemoPlaybackUpdate, {
        threshold: thresholds,
      });
      for (const video of demoVideos) observer.observe(video);
    }

    for (const frame of demoFrames) {
      const video = frame.querySelector<HTMLVideoElement>('[data-demo-video]');
      if (!video) continue;

      frame.addEventListener('click', () => toggleDemoVideo(video));
      frame.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          toggleDemoVideo(video);
        }
      });
    }

    window.addEventListener('scroll', clearManualDemoVideo, { passive: true });
    window.addEventListener('resize', scheduleDemoPlaybackUpdate);
    window.addEventListener('pageshow', scheduleDemoPlaybackUpdate);
    document.addEventListener('visibilitychange', scheduleDemoPlaybackUpdate);
    scheduleDemoPlaybackUpdate();
  }
</script>
</Layout>
