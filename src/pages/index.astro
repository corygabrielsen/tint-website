---
import { Code } from 'astro:components';
import Layout from '~/layouts/Layout.astro';
import CopyButton from '~/components/CopyButton.astro';
import GitHubMark from '~/components/GitHubMark.astro';

const repoUrl = 'https://github.com/corygabrielsen/tint';

// Install lines stay tight on purpose: mkdir/PATH guidance live in the tint
// README, not here. `brew install user/repo/formula` auto-taps the third-party
// tap on first install, so no `brew tap` step is needed.
const installCommands = [
  { label: 'brew', code: 'brew install corygabrielsen/tint/tint' },
  {
    label: 'curl',
    code: `curl -fsSL ${repoUrl}/releases/latest/download/tint -o ~/.local/bin/tint && chmod +x ~/.local/bin/tint`,
  },
];

// Hue-sorted colors from public/favicon.svg.
const themeColors = [
  '#AC5353',
  '#AC7453',
  '#AC9653',
  '#A1AC53',
  '#80AC53',
  '#5EAC53',
  '#53AC69',
  '#53AC8B',
  '#53ACAC',
  '#538BAC',
  '#5369AC',
  '#5E53AC',
  '#8053AC',
  '#A153AC',
  '#AC5396',
  '#AC5374',
];
---

<Layout title="tint - Terminal Theme Switcher">
  <main>
    <header>
      <h1>tint</h1>
      <div class="theme-strip" aria-hidden="true">
        {themeColors.map((color) => (
          <span style={`background-color: ${color}`}></span>
        ))}
      </div>
      <p class="tagline">Terminal theme switcher.</p>
    </header>

    {/* Pure-CSS tabbed code blocks. The radios share the <fieldset> as a
        single parent and stay in stable source order so the
        `:has(input:nth-of-type(N):checked)` + `:nth-child(N)` selectors in
        global.css correctly map each radio to its label and panel. That
        positional invariant is why this widget renders three separate
        `installCommands.map()` passes instead of one combined loop. */}
    <fieldset class="install-tabs">
      <legend class="sr-only">Install method</legend>
      {installCommands.map((cmd, i) => (
        <input class="sr-only" type="radio" name="install" id={`install-${cmd.label}`} checked={i === 0} />
      ))}
      <div class="tabs">
        {installCommands.map((cmd) => (
          <label for={`install-${cmd.label}`}>{cmd.label}</label>
        ))}
      </div>
      <div class="panels">
        {installCommands.map((cmd) => (
          <div class="panel">
            <CopyButton code={cmd.code} />
            <Code code={cmd.code} lang="sh" theme="css-variables" />
          </div>
        ))}
      </div>
    </fieldset>

    {/* TODO: Add a small static poster image for MP4 load/decode failures. */}
    <video
      class="demo"
      src="demo.mp4"
      autoplay
      loop
      muted
      playsinline
      width="824"
      height="450"
      aria-label="tint demo: picker, CLI, cd-hook auto-tinting, custom theme"
    ></video>

    <p class="github-link">
      <a href={repoUrl} aria-label="GitHub repository">
        <GitHubMark />
      </a>
    </p>

    <p class="copyright">© 2026 Cory Gabrielsen</p>
  </main>
</Layout>
