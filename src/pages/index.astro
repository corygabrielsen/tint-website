---
import { Code } from 'astro:components';
import Layout from '~/layouts/Layout.astro';
import CopyButton from '~/components/CopyButton.astro';
import GitHubMark from '~/components/GitHubMark.astro';

const repoUrl = 'https://github.com/corygabrielsen/tint';

const installCommands = [
  { label: 'brew', code: 'brew install corygabrielsen/tint/tint' },
  {
    label: 'curl',
    code: `curl -fsSL ${repoUrl}/releases/latest/download/tint -o ~/.local/bin/tint && chmod +x ~/.local/bin/tint`,
  },
];
---

<Layout title="tint">
  <main>
    <header>
      <h1>tint</h1>
      <p class="tagline">Terminal theme switcher.</p>
    </header>

    {/* Pure-CSS tabbed code blocks. The radio inputs MUST sit as direct
        siblings of `.tabs` and `.panels` so the CSS sibling combinator can
        match the active tab/panel — that's why this widget renders three
        separate `installCommands.map()` passes instead of one. */}
    <fieldset class="install-tabs">
      <legend class="sr-only">Install method</legend>
      {installCommands.map((cmd, i) => (
        <input type="radio" name="install" id={`install-${cmd.label}`} checked={i === 0} />
      ))}
      <div class="tabs">
        {installCommands.map((cmd) => (
          <label for={`install-${cmd.label}`}>{cmd.label}</label>
        ))}
      </div>
      <div class="panels">
        {installCommands.map((cmd) => (
          <div class="panel">
            <CopyButton code={cmd.code} />
            <Code code={cmd.code} lang="sh" theme="css-variables" />
          </div>
        ))}
      </div>
    </fieldset>

    <div class="demo-placeholder">Demo coming soon</div>

    <p class="github-link">
      <a href={repoUrl} aria-label="GitHub repository">
        <GitHubMark />
      </a>
    </p>

    <p class="copyright">© 2026 Cory Gabrielsen</p>
  </main>
</Layout>
